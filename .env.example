# ─────────────────────────────────────────────────────────────────────────────
# FreeSolo — full configuration reference
#
# These are the variables the applications themselves read, whatever runs them:
# docker compose, a bare `java -jar freesolo-api.jar`, Kubernetes, Fly, Render,
# a systemd unit. Nothing here assumes the bundled compose stack — point
# DATABASE_URL at a managed Postgres and MINIO_* at S3 or R2, and the images
# run unchanged.
#
# docker-compose.yml is one such runner, and it is deliberately narrow: it reads
# only the short names in the "docker compose only" block at the bottom and
# composes them into the variables below, because it always wires the bundled
# db/minio containers. To run compose against something external instead, drop
# that service and set the real variable in a compose override file — the block
# at the bottom is compose's vocabulary, not the app's.
#
# Copy to .env and fill in. Every value is intentionally empty so this tracked
# template cannot be mistaken for usable configuration. Values marked REQUIRED
# have no safe default and the app refuses to start without them.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ Public URLs ═════════════════════════════════════════════════════════════
# Used to derive CORS, callbacks and the API base the browser/app talks to.
# Also the defaults docker-compose feeds to the per-service variables below.

# Where the web app is served from (browser-visible origin).
APP_URL=
# Where the API is reachable from the browser and mobile app (public origin).
API_URL=
# Where uploaded files are served from (MinIO/S3 public origin or CDN).
STORAGE_URL=


# ═══ API — Spring Boot (api/) ════════════════════════════════════════════════

# ── Runtime ──────────────────────────────────────────────────────────────────
# "production" turns on secure cookies, SameSite=None and framework-level
# forwarded-header handling. Leave unset for local development.
SPRING_PROFILES_ACTIVE=production
# Port the embedded server binds. The image already exposes 8080.
PORT=8080

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# Full JDBC URL. Managed Postgres example:
# jdbc:postgresql://db.example.com:5432/freesolo?sslmode=require
DATABASE_URL=
# Spring reads the credentials separately from the URL. SPRING_DATASOURCE_USERNAME
# and SPRING_DATASOURCE_PASSWORD are equivalent (Spring's own binding) and take
# precedence if both are set — docker-compose.yml uses those.
POSTGRES_USER=
POSTGRES_PASSWORD=

# ── JWT (Secret REQUIRED) ────────────────────────────────────────────────────
# At least 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=
# Token lifetime in milliseconds. Default 2592000000 = 30 days.
JWT_EXPIRATION_MS=2592000000

# ── URLs, CORS and cookies ───────────────────────────────────────────────────
# Comma-separated. Must include the web origin and, for the mobile app, its
# schemes (exp:// during development, freesolo:// for release builds).
CORS_ORIGINS=
# Used to build links in emails and OAuth redirects.
FRONTEND_URL=
# Both are forced on by the production profile; set them only when running
# without that profile behind TLS.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# ── Bootstrap admin ──────────────────────────────────────────────────────────
# The account seeded on first start and granted admin rights.
ADMIN_EMAIL=

# ── Object storage — MinIO / S3 / R2 (REQUIRED) ──────────────────────────────
# Endpoint is what the API talks to; public URL is what browsers are handed.
# They differ whenever storage sits behind a CDN or a private network.
MINIO_ENDPOINT=
MINIO_PUBLIC_URL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=freesolo

# ── Email — Resend (optional) ────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=FreeSolo <noreply@freesolo.app>

# ── Stripe billing (optional) ────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# From the Stripe dashboard's webhook endpoint, not the API keys page.
STRIPE_WEBHOOK_SECRET=

# ── Social sign-in (optional) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
# Apple's is a signed JWT you generate from your .p8 key, not a static string.
APPLE_CLIENT_SECRET=

# ── Push notifications and store links (optional) ────────────────────────────
# Expo access token used to send push notifications.
EXPO_ACCESS_TOKEN=
APP_STORE_URL=
PLAY_STORE_URL=


# ═══ Web — Next.js (web/) ════════════════════════════════════════════════════

# ── Build time (NEXT_PUBLIC_* are inlined into the bundle) ───────────────────
# Changing this needs a rebuild, not a restart. When building the image
# yourself, pass it as --build-arg APP_URL.
NEXT_PUBLIC_APP_URL=

# ── Runtime ──────────────────────────────────────────────────────────────────
# API base for server-side calls and the /api/** rewrite. Note the rewrite is
# also baked at build time from the SPRING_BOOT_API_URL build arg, so the
# browser-facing value must be set at build; this one covers server-side calls
# and can be an internal address the browser never sees.
SPRING_BOOT_API_URL=
# The web app verifies session tokens itself, so it needs the same JWT_SECRET
# set in the API section above — one value, given to both services.
#
# Port/host the Next server binds are already set in the image (3000 /
# 0.0.0.0); PORT is declared once in the API section, so override it per
# service rather than here if you need a different one.


# ═══ Mobile — Expo (mobile/) ═════════════════════════════════════════════════
# Read from mobile/.env, not this file — listed here so the full surface is in
# one place. Baked into the JS bundle at build time; never put secrets here.

# API base the app calls. On a physical device this must be a LAN IP or public
# host, never localhost.
EXPO_PUBLIC_API_URL=
# Publishable key only — the secret key belongs on the API.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=


# ═══ docker compose only ═════════════════════════════════════════════════════
# Bootstrap credentials for the bundled db/minio containers. Ignored entirely
# when you deploy the images against managed services — in that case the
# credentials live in DATABASE_URL / POSTGRES_* / MINIO_* above instead.
#
# POSTGRES_PASSWORD is not repeated here: the API reads it directly, so the one
# in the database section above is the same variable and compose reuses it.

# Compose feeds this to both the MinIO container's root password and the API's
# MINIO_SECRET_KEY.
MINIO_PASSWORD=
