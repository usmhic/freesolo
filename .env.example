# Copy to .env and fill in the empty secrets. Optional integrations can stay empty.

# Ports
WEB_PORT=3002
API_PORT=8080
EXPO_PORT=8083
POSTGRES_PORT=5434
MINIO_PORT=9020
MINIO_CONSOLE_PORT=9021

# URLs
APP_URL=http://localhost:3002
SPRING_BOOT_API_URL=http://localhost:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# Database
DATABASE_URL=jdbc:postgresql://localhost:5434/freesolo
POSTGRES_USER=freesolo
POSTGRES_PASSWORD=

# Auth
JWT_SECRET=
ADMIN_EMAIL=admin@freesolo.local

# Storage
MINIO_ENDPOINT=http://localhost:9020
MINIO_PUBLIC_URL=http://localhost:9020
MINIO_ACCESS_KEY=freesolo
MINIO_PASSWORD=

# Optional integrations
ORS_API_KEY=
RESEND_API_KEY=
EXPO_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
