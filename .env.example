# Local development; keep secrets in .env only.

# Local ports
WEB_PORT=3002
API_PORT=8080
EXPO_PORT=8083
POSTGRES_PORT=5434
MINIO_PORT=9020
MINIO_CONSOLE_PORT=9021

# Public URLs
APP_URL=http://localhost:3002
API_URL=http://localhost:8080
STORAGE_URL=http://localhost:9020

# API and database
SPRING_PROFILES_ACTIVE=
PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5434/freesolo
POSTGRES_USER=freesolo
POSTGRES_PASSWORD=

# Authentication
JWT_SECRET=
JWT_EXPIRATION_MS=2592000000
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*,exp://*,freesolo://*
FRONTEND_URL=http://localhost:3002
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
ADMIN_EMAIL=admin@freesolo.local

# Storage
MINIO_ENDPOINT=http://localhost:9020
MINIO_PUBLIC_URL=http://localhost:9020
MINIO_ACCESS_KEY=freesolo
MINIO_SECRET_KEY=
MINIO_BUCKET=freesolo
MINIO_PASSWORD=

# Email (optional)
RESEND_API_KEY=
EMAIL_FROM="FreeSolo <noreply@freesolo.app>"

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Mobile delivery (optional)
EXPO_ACCESS_TOKEN=
APP_STORE_URL=
PLAY_STORE_URL=

# Web and mobile
NEXT_PUBLIC_APP_URL=http://localhost:3002
SPRING_BOOT_API_URL=http://localhost:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
