# Copy to .env and fill in the empty secrets. Optional services stay off while their keys are empty.

# App
APP_URL=http://localhost:3002
WEB_PORT=3002
API_PORT=8080
EXPO_PORT=8083
SPRING_BOOT_API_URL=http://localhost:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# Database
POSTGRES_PORT=5434
POSTGRES_USER=freesolo
POSTGRES_PASSWORD=
DATABASE_URL=jdbc:postgresql://localhost:5434/freesolo

# Sign-in
JWT_SECRET=
ADMIN_EMAIL=admin@freesolo.local

# File storage
MINIO_PORT=9020
MINIO_CONSOLE_PORT=9021
MINIO_ENDPOINT=http://localhost:9020
MINIO_PUBLIC_URL=http://localhost:9020
MINIO_USER=freesolo
MINIO_PASSWORD=

# AI answer checking (optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Routing and place search (optional)
ORS_API_KEY=

# Email and push notifications (optional)
RESEND_API_KEY=
EXPO_ACCESS_TOKEN=

# Google and Apple sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
