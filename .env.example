# ─────────────────────────────────────────────────────────────────────────────
# FreeSolo — full configuration reference
#
# These are the variables the applications themselves read, whatever runs them:
# docker compose, a bare `java -jar freesolo-api.jar`, Kubernetes, Fly, Render,
# a systemd unit. Nothing here assumes the bundled compose stack — point
# DATABASE_URL at a managed Postgres and MINIO_* at S3 or R2, and the images
# run unchanged.
#
# docker-compose.yml is one such runner, and it is deliberately narrow: it reads
# only the short names in the "docker compose only" block at the bottom and
# composes them into the variables below, because it always wires the bundled
# db/minio containers. To run compose against something external instead, drop
# that service and set the real variable in a compose override file — the block
# at the bottom is compose's vocabulary, not the app's.
#
# Copy to .env and fill in. Everything that is not a secret already carries a
# working localhost default, so a copy of this file runs the bundled compose
# stack once you fill the handful of values marked FILL ME at the bottom.
#
# Secrets are deliberately empty: a tracked file must never be mistakable for
# usable credentials. Values marked REQUIRED have no safe default and the app
# refuses to start without them.
#
# .env is gitignored. Keep it in this same order so a diff between the two stays
# readable, and never commit it.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ Public URLs ═════════════════════════════════════════════════════════════
# Used to derive CORS, callbacks and the API base the browser/app talks to.
# Also the defaults docker-compose feeds to the per-service variables below.

# Where the web app is served from (browser-visible origin).
APP_URL=http://localhost:3000
# Where the API is reachable from the browser and mobile app (public origin).
# Compose bakes this into the web image's /api/** rewrite at build time.
API_URL=http://localhost:8080
# Where uploaded files are served from (MinIO/S3 public origin or CDN).
STORAGE_URL=http://localhost:9000


# ═══ API — Spring Boot (api/) ════════════════════════════════════════════════

# ── Runtime ──────────────────────────────────────────────────────────────────
# "production" turns on secure cookies, SameSite=None and framework-level
# forwarded-header handling — none of which a plain-HTTP localhost can satisfy,
# so it stays unset here. Set it to "production" when deploying.
SPRING_PROFILES_ACTIVE=
# Port the embedded server binds. The image already exposes 8080.
PORT=8080

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# Full JDBC URL. Compose overrides the host with its own service name, so this
# value matters when running the API outside compose.
# Managed: jdbc:postgresql://db.example.com:5432/freesolo?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/freesolo
# Spring reads the credentials separately from the URL. SPRING_DATASOURCE_USERNAME
# and SPRING_DATASOURCE_PASSWORD are equivalent (Spring's own binding) and take
# precedence if both are set — docker-compose.yml uses those.
POSTGRES_USER=freesolo
# FILL ME — compose uses this to bootstrap the bundled Postgres container.
# Any local-only string works; it never leaves your machine.
POSTGRES_PASSWORD=

# ── JWT (Secret REQUIRED) ────────────────────────────────────────────────────
# FILL ME — at least 32 chars. Generate: openssl rand -base64 48
# One value, given to both the API and the web app: the web app verifies session
# tokens itself rather than calling the API on every request.
JWT_SECRET=
# Token lifetime in milliseconds. Default 2592000000 = 30 days.
JWT_EXPIRATION_MS=2592000000

# ── URLs, CORS and cookies ───────────────────────────────────────────────────
# Comma-separated origin *patterns* — "*" is allowed, including in the port, so
# a single entry covers whichever local port a client comes up on. Must include
# the web origin and, for the mobile app, its schemes (exp:// during
# development, freesolo:// for release builds). Pin exact origins in production.
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*,exp://*,freesolo://*
# Used to build links in emails and OAuth redirects.
FRONTEND_URL=http://localhost:3000
# Both are forced on by the production profile; set them only when running
# without that profile behind TLS.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# ── Bootstrap admin ──────────────────────────────────────────────────────────
# The account seeded on first start and granted admin rights. Sign in with this
# address to reach /admin.
ADMIN_EMAIL=admin@freesolo.local

# ── Object storage — MinIO / S3 / R2 (REQUIRED) ──────────────────────────────
# Endpoint is what the API talks to; public URL is what browsers are handed.
# They differ whenever storage sits behind a CDN or a private network.
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=freesolo
# FILL ME outside compose — compose passes MINIO_PASSWORD from the bottom block.
MINIO_SECRET_KEY=
MINIO_BUCKET=freesolo

# ── Email — Resend (optional) ────────────────────────────────────────────────
# With no API key the API logs the message instead of sending it, which is what
# you want locally — OTP codes appear in the API log, so you can sign in without
# a real mailbox.
RESEND_API_KEY=
EMAIL_FROM=FreeSolo <noreply@freesolo.app>

# ── Social sign-in (optional) ────────────────────────────────────────────────
# Leave unset locally and use the email OTP flow instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
# Apple's is a signed JWT you generate from your .p8 key, not a static string.
APPLE_CLIENT_SECRET=

# ── Push notifications and store links (optional) ────────────────────────────
# Expo access token used to send push notifications. Unset locally — pushes are
# skipped rather than failing.
EXPO_ACCESS_TOKEN=
APP_STORE_URL=
PLAY_STORE_URL=


# ═══ Web — Next.js (web/) ════════════════════════════════════════════════════

# ── Build time (NEXT_PUBLIC_* are inlined into the bundle) ───────────────────
# Changing this needs a rebuild, not a restart. When building the image
# yourself, pass it as --build-arg APP_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Runtime ──────────────────────────────────────────────────────────────────
# API base for server-side calls and the /api/** rewrite. Note the rewrite is
# also baked at build time from the SPRING_BOOT_API_URL build arg, so the
# browser-facing value must be set at build; this one covers server-side calls
# and can be an internal address the browser never sees. In compose that is
# http://api:8080; running `pnpm dev` outside compose, localhost is what you want.
SPRING_BOOT_API_URL=http://localhost:8080
# The web app verifies session tokens itself, so it needs the same JWT_SECRET
# set in the API section above — one value, given to both services.
#
# Port/host the Next server binds are already set in the image (3000 /
# 0.0.0.0); PORT is declared once in the API section, so override it per
# service rather than here if you need a different one.


# ═══ Mobile — Expo (mobile/) ═════════════════════════════════════════════════
# Read from mobile/.env, not this file — listed here so the full surface is in
# one place. Baked into the JS bundle at build time; never put secrets here.

# API base the app calls. On a physical device replace localhost with your
# machine's LAN IP (e.g. http://192.168.1.20:8080) — a device cannot reach
# localhost on your laptop.
EXPO_PUBLIC_API_URL=http://localhost:8080


# ═══ docker compose only — FILL ME ═══════════════════════════════════════════
# Bootstrap credentials for the bundled db/minio containers. Ignored entirely
# when you deploy the images against managed services — in that case the
# credentials live in DATABASE_URL / POSTGRES_* / MINIO_* above instead.
#
# Together with POSTGRES_PASSWORD and JWT_SECRET above, this is the whole set of
# values you must supply to run the bundled stack. POSTGRES_PASSWORD is not
# repeated here: the API reads it directly, so the one in the database section
# above is the same variable and compose reuses it.
#
# Any local-only string works; it never leaves your machine.

# Compose feeds this to both the MinIO container's root password and the API's
# MINIO_SECRET_KEY.
MINIO_PASSWORD=
